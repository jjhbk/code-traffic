{
  "expo": {
    "name": "Signal Box",
    "slug": "signal-box-mobile",
    "plugins": ["expo-notifications"],
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "signalbox",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Signal Box uses your location only when you enable a location-aware assistant context."
      }
    },
    "android": {
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    }
  }
}
