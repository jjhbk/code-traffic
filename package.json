{
  "name": "signal-box",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A desktop signal board for Claude Code sessions",
  "main": "main.js",
  "scripts": {
    "hooks:print": "node hooks.js --print",
    "start": "electron-forge start",
    "install-hooks": "node hooks.js --install",
    "install-codex-hooks": "node codex-hooks.js --install",
    "postinstall": "electron-rebuild -f -w node-pty || true",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "install:local": "node scripts/install-local.js"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.2.0",
    "electron": "^44.3.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dotenv": "^17.4.2",
    "electron-squirrel-startup": "^1.0.1",
    "node-pty": "^1.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
