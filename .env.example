# Create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=123456:replace-with-your-token

# Leave blank initially. Start Signal Box and send /start to your bot to get it.
TELEGRAM_CHAT_ID=

# Public desktop OAuth client ID supplied by the Signal Box release build.
# Users authorize in their browser; never ask them for this value in the UI.
SIGNAL_BOX_GOOGLE_CLIENT_ID=

# Model routing. Default is local and falls back to deterministic ranking if Ollama is unavailable.
SIGNAL_BOX_MODEL_MODE=local
SIGNAL_BOX_LOCAL_MODEL=qwen3:4b-instruct

# Optional OpenAI-compatible frontier endpoint. Use SIGNAL_BOX_MODEL_MODE=frontier to enable it.
SIGNAL_BOX_FRONTIER_BASE_URL=https://api.openai.com/v1
SIGNAL_BOX_FRONTIER_MODEL=gpt-4o-mini
SIGNAL_BOX_FRONTIER_API_KEY=
